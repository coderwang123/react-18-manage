{
  "include": ["./**/*.ts", "./**/*.tsx", "vite.config.ts","src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "env.d.ts", "src/**/*", "auto-imports.d.ts", "components.d.ts"],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "lib": ["es2021", "DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "node",
    "types": ["unplugin-vue-define-options/macros-global", "vite/client", "node", "unplugin-icons/types/react", "vite-plugin-svg-icons/client"],

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
  
    "useDefineForClassFields": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
}
